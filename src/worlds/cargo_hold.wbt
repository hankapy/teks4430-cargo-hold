#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"

WorldInfo {
  info [
    "TEKS4430 course project"
    "Bulk carrier cargo hold: gas monitoring and surface ventilation"
    "Front wall is transparent to show the cargo"
    "Rover on the deck rail samples gas from four ports, one per zone"
  ]
  title "Cargo hold monitoring"
  basicTimeStep 32
}
Viewpoint {
  orientation -0.1949 0.4101 0.8910 0.9798
  position -11 -14 12.5
}
TexturedBackground {
  texture "noon_cloudy_countryside"
}
TexturedBackgroundLight {
  texture "noon_cloudy_countryside"
}

# ---------------------------------------------------------------- hull (static)
Solid {
  translation 0 0 0.15
  children [
    Shape {
      appearance DEF HULL_MAT PBRAppearance { baseColor 0.25 0.3 0.35 roughness 0.6 metalness 0.3 }
      geometry Box { size 12 8 0.3 }
    }
  ]
  name "tank_top"
}
Solid {
  translation 0 3.85 3.15
  children [
    Shape {
      appearance USE HULL_MAT
      geometry Box { size 12 0.3 5.7 }
    }
  ]
  name "wall_port"
}
Solid {
  translation 0 -3.85 3.15
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.9 0.9 0.9
        transparency 0.85
        roughness 0.1
        metalness 0
      }
      geometry Box { size 12 0.3 5.7 }
    }
  ]
  name "wall_starboard_cutaway"
}
Solid {
  translation 5.85 0 3.15
  children [
    Shape {
      appearance USE HULL_MAT
      geometry Box { size 0.3 7.4 5.7 }
    }
  ]
  name "bulkhead_fwd"
}
Solid {
  translation -5.85 0 3.15
  children [
    Shape {
      appearance USE HULL_MAT
      geometry Box { size 0.3 7.4 5.7 }
    }
  ]
  name "bulkhead_aft"
}
Solid {
  translation 0 0 6.15
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.45 0.47 0.5
        roughness 0.7
        metalness 0.2
      }
      geometry Box { size 12 8 0.3 }
    }
  ]
  name "main_deck"
}
Solid {
  translation -0.5 0 6.55
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.1 0.35 0.45
        roughness 0.5
        metalness 0.3
      }
      geometry Box { size 7.5 5.5 0.5 }
    }
  ]
  name "hatch_cover"
}

# ---------------------------------------------------------------- cargo
Solid {
  translation 0 0 1.8
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.08 0.08 0.08
        roughness 1
        metalness 0
      }
      geometry Box { size 11.4 7.4 3 }
    }
  ]
  name "cargo_coal"
}

