Solid {
  translation 4.5 2.5 7.05
  children [
    Shape {
      appearance DEF TRUNK_MAT PBRAppearance { baseColor 0.85 0.85 0.8 roughness 0.5 metalness 0.4 }
      geometry Cylinder { radius 0.35 height 1.5 }
    }
  ]
  name "intake_trunk"
}
Solid {
  translation 4.5 -2.5 7.05
  children [
    Shape {
      appearance USE TRUNK_MAT
      geometry Cylinder { radius 0.35 height 1.5 }
    }
  ]
  name "exhaust_trunk"
}
Solid {
  translation -5.75 -1.6 6.8
  children [
    Shape {
      appearance USE TRUNK_MAT
      geometry Box { size 0.3 1.2 1 }
    }
  ]
  name "control_panel"
}
