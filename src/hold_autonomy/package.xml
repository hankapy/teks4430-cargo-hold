<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hold_autonomy</name>
  <version>0.1.0</version>
  <description>Autonomous cargo hold gas monitoring and ventilation</description>
  <maintainer email="student@example.com">Hanna Pyrhonen</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>hold_interfaces</depend>
  <depend>webots_ros2_driver</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>py_trees</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
